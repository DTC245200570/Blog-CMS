# Co so du lieu MySQL (bat buoc dat mat khau truoc khi khoi chay)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=blog_db
MYSQL_USER=blog_user
MYSQL_PASSWORD=
MYSQL_PORT=3306

# MySQL Exporter (tai khoan rieng co quyen toi thieu de thu thap metrics)
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=

# Ung dung WordPress
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=0

# Nginx Proxy (cong cong khai ra host)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# phpMyAdmin (duong dan goc phuc vu qua reverse proxy)
PMA_ABSOLUTE_URI=https://localhost/pma/

# He thong giam sat va quan ly log (chi bind tren loopback 127.0.0.1)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
