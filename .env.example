# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN BLOG/CMS (WORDPRESS) - ĐỀ TÀI 7
# Sao chép file này thành .env trước khi chạy docker compose:
# cp .env.example .env (hoặc copy .env.example .env trên Windows)
# ==============================================================================

# Cấu hình CSDL MySQL
MYSQL_ROOT_PASSWORD=SuperSecureRootPassword_2026!
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wp_user
MYSQL_PASSWORD=StrongWpPassword_2026!
MYSQL_PORT=3306

# Cấu hình WordPress
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=0

# Cấu hình Cổng Nginx (Reverse Proxy)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Cấu hình phpMyAdmin
PMA_PORT=8080

# Cấu hình Giám sát Grafana (Dành cho Commit 2)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=AdminGrafanaSecure2026!
GRAFANA_PORT=3000

# Cấu hình Prometheus & Loki (Dành cho Commit 2 & 3)
PROMETHEUS_PORT=9090
LOKI_PORT=3100
